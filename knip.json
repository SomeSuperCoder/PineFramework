{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/index.ts",
        "src/frontend-safe.ts",
        "src/trading/wallet/wallet-manager.ts",
        "src/trading/config-store.ts",
        "src/trading/trade-history-store.ts",
        "src/trading/telegram-bot.ts",
        "src/strategy/jupiter-fee-fetcher.ts",
        "src/utils/time.ts",
        "src/utils/logger/types.ts",
        "src/utils/script-name.ts",
        "src/util/candle-string-format.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "frontend": {
      "entry": ["src/main.tsx", "src/components/ui/*.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "shadcn",
        "tailwindcss",
        "tw-animate-css"
      ]
    },
    "backend": {
      "entry": ["src/index.ts", "src/cli/backtest-cli.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": true
}

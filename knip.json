{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/frontend-safe.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "frontend": {
      "entry": [
        "src/components/ui/*.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}"
      ]
    },
    "backend": {
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    }
  },
  "ignoreExportsUsedInFile": true
}
{
  "name": "pine-framework",
  "private": true,
  "version": "0.1.0",
  "description": "Pine Script v6 compatible execution and rendering engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./trading/wallet": {
      "source": "./src/trading/wallet/wallet-manager.ts",
      "types": "./dist/trading/wallet/wallet-manager.d.ts",
      "import": "./dist/trading/wallet/wallet-manager.js"
    },
    "./trading/config-store": {
      "source": "./src/trading/config-store.ts",
      "types": "./dist/trading/config-store.d.ts",
      "import": "./dist/trading/config-store.js"
    },
    "./trading/trade-history-store": {
      "source": "./src/trading/trade-history-store.ts",
      "types": "./dist/trading/trade-history-store.d.ts",
      "import": "./dist/trading/trade-history-store.js"
    },
    "./trading/telegram-bot": {
      "source": "./src/trading/telegram-bot.ts",
      "types": "./dist/trading/telegram-bot.d.ts",
      "import": "./dist/trading/telegram-bot.js"
    },
    "./strategy/jupiter-fee-fetcher": {
      "source": "./src/strategy/jupiter-fee-fetcher.ts",
      "types": "./dist/strategy/jupiter-fee-fetcher.d.ts",
      "import": "./dist/strategy/jupiter-fee-fetcher.js"
    },
    "./utils/time": {
      "source": "./src/utils/time.ts",
      "types": "./dist/utils/time.d.ts",
      "import": "./dist/utils/time.js"
    },
    "./utils/logger/types": {
      "source": "./src/utils/logger/types.ts",
      "types": "./dist/utils/logger/types.d.ts",
      "import": "./dist/utils/logger/types.js"
    },
    "./utils/script-name": {
      "source": "./src/utils/script-name.ts",
      "types": "./dist/utils/script-name.d.ts",
      "import": "./dist/utils/script-name.js"
    },
    "./util/candle-string-format": {
      "source": "./src/util/candle-string-format.ts",
      "types": "./dist/util/candle-string-format.d.ts",
      "import": "./dist/util/candle-string-format.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm --filter pine-framework-backend dev\" \"pnpm --filter pine-framework-frontend dev\"",
    "build": "pnpm --filter pine-framework run build:lib && pnpm --filter pine-framework-backend run build && pnpm --filter pine-framework-frontend run build",
    "build:lib": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "knip": "knip",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "pnpm -r typecheck",
    "backtest": "pnpm --filter pine-framework-backend backtest"
  },
  "keywords": [
    "pine-script",
    "tradingview",
    "technical-analysis",
    "backtesting"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vitest/coverage-v8": "3.2.6",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "knip": "^6.32.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@jup-ag/api": "^6.0.48",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.4",
    "ed25519-hd-key": "^2.0.0",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bufferutil",
      "esbuild",
      "utf-8-validate"
    ]
  }
}
